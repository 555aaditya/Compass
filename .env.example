APP_ENV=development
# DATABASE_URL=sqlite:///<absolute path>  (default: <repo>/data/compass.db)

# Candidate knowledge base: the Resume Wiki folder of a local Quant-Journal checkout (pull it before syncing)
WIKI_PATH=~/Documents/GitHub/Quant-Journal/V2.0/10-Resume-Wiki
# Wiki pages that describe the product itself and must never count as candidate evidence
WIKI_PRODUCT_CONTEXT_PAGES=["projects/compass.md"]

MASTER_RESUME_PATH=./resumes/master/main.tex
GENERATED_RESUMES_PATH=./resumes/generated

# Optional: only needed if the wiki is read through the GitHub API instead of a local checkout
GITHUB_TOKEN=

# Telegram (free): create a bot with @BotFather, then message it once and read the chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (Gmail needs an app password)
SMTP_HOST=
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_TO=

# WhatsApp Business Cloud API (official, disabled by default)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=

JOB_SCAN_INTERVAL_HOURS=12
WIKI_SYNC_INTERVAL_HOURS=24
SCHEDULER_ENABLED=true

MINIMUM_MATCH_SCORE=70
JOB_FRESHNESS_DAYS=14
AUTO_GENERATE_RESUMES=true
REQUIRE_RESUME_APPROVAL=true
